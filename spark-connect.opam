# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Spark Connect client for OCaml"
description:
  "A pure OCaml client for Apache Spark's Spark Connect protocol: gRPC over h2, protobuf via ocaml-protoc, and a built-in Arrow IPC reader/writer. Build DataFrame plans in OCaml and run them on any Spark 4.x Connect server."
maintainer: ["Lisa Cao"]
authors: ["Lisa Cao"]
license: "Apache-2.0"
homepage: "https://github.com/lisancao/spark-connect-ocaml"
bug-reports: "https://github.com/lisancao/spark-connect-ocaml/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.0"}
  "pbrt" {>= "4.0"}
  "ocaml-protoc" {>= "4.0"}
  "h2" {>= "0.13"}
  "h2-lwt-unix" {>= "0.13"}
  "lwt" {>= "5.0"}
  "uri"
  "bigstringaf"
  "tls" {>= "1.0"}
  "tls-lwt" {>= "1.0"}
  "ca-certs"
  "domain-name"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lisancao/spark-connect-ocaml.git"
