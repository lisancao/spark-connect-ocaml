; OCaml types + binary codecs generated from the vendored Spark Connect protos.
; Regenerated on every build from ../../proto; never edit the .ml files.

(library
 (name spark_connect_proto)
 (public_name spark-connect.proto)
 (libraries pbrt)
 (flags
  (:standard -w -a)))

(rule
 (targets
  any.ml
  any.mli
  timestamp.ml
  timestamp.mli
  status.ml
  status.mli
  error_details.ml
  error_details.mli
  base.ml
  base.mli
  catalog.ml
  catalog.mli
  commands.ml
  commands.mli
  common.ml
  common.mli
  expressions.ml
  expressions.mli
  ml.ml
  ml.mli
  ml_common.ml
  ml_common.mli
  pipelines.ml
  pipelines.mli
  relations.ml
  relations.mli
  types.ml
  types.mli)
 (deps
  (source_tree %{project_root}/proto))
 (action
  (progn
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/google/protobuf/any.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/google/protobuf/timestamp.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/google/rpc/status.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/google/rpc/error_details.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/types.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/common.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/expressions.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/catalog.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/ml_common.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/relations.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/ml.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/pipelines.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/commands.proto)
   (run
    ocaml-protoc
    --binary
    --pp
    -I
    %{project_root}/proto
    --ml_out
    .
    %{project_root}/proto/spark/connect/base.proto)
   (run
    %{exe:fixup/fixup.exe}
    relations.ml
    base.ml
    commands.ml
    expressions.ml
    catalog.ml
    common.ml
    types.ml
    ml.ml
    ml_common.ml
    pipelines.ml))))
